<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AssemblyName>水利工程基础信息一张图</AssemblyName>
    <RootNamespace>ShuiliMapWater</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- 单文件发布，双击即开，无外部 :7205 服务 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>
  <!-- 网页资源：webroot 作为内容随包释放，运行时映射到虚拟主机 app.local -->
  <ItemGroup>
    <Content Include="webroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- 排除历史备份 .cs（形如 <原名><12位时间戳>.cs）：默认 glob 会把备份一并编译，
       与 Program.cs 重复定义类型（CS0111）导致 publish 失败 -->
  <ItemGroup>
    <Compile Remove="Program20*.cs" />
  </ItemGroup>
</Project>
