{
  "name": "gujian-daka",
  "productName": "古建景点打卡",
  "version": "2.2.0",
  "description": "古建景点打卡（天地图底图 · 奥维 ovkmz 互通）",
  "author": "炎冰",
  "homepage": "https://techpromo.cn/gujian-daka",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack:nsis": "electron-builder --win nsis --x64",
    "pack:msi": "electron-builder --win msi --x64",
    "pack:all": "electron-builder --win --x64",
    "pack:linux": "electron-builder --linux --x64"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "cn.gujian.daka",
    "productName": "古建景点打卡",
    "copyright": "Copyright © 2026 炎冰",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "jingmi_app/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}V${version}_win64.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "jingmi_app/icon-512.png",
      "category": "Utility",
      "maintainer": "yanbing <yanbing@techpromo.cn>",
      "synopsis": "古建景点打卡（天地图底图 · 奥维 ovkmz 互通）",
      "desktop": {
        "entry": {
          "Name": "古建景点打卡",
          "Comment": "浏览、筛选、增删改、多照片、ovkmz 导入导出",
          "Categories": "Utility;Office;"
        }
      },
      "artifactName": "${productName}V2.2_linux_${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "水利工程一张图",
      "deleteAppDataOnUninstall": false
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "additionalLightArgs": [
        "-cultures:zh-CN",
        "-sval"
      ]
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  }
}